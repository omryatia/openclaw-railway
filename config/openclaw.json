{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "trustedProxies": ["127.0.0.1", "::1"],
    "controlUi": {}
  },
  "agents": {
    "defaults": {
      "workspace": "/data/workspace",
      "sandbox": {
        "mode": "non-main"
      }
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "tools": {
    "allow": ["read", "write", "edit", "web_search", "web_fetch", "apply_patch"],
    "deny": ["exec"],
    "elevated": {
      "enabled": false
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "pairing",
      "groupPolicy": "disabled"
    },
    "discord": {
      "dmPolicy": "pairing"
    },
    "slack": {
      "dmPolicy": "pairing"
    },
    "whatsapp": {}
  }
}
